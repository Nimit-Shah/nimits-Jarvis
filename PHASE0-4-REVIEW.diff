+
+/** Manual/auto release: ANY row of the holder project releases the project lease. */
+export async function releaseLocksHeldBy(serverId: string): Promise<number> {
+  const row = await db.mcpServer
+    .findUnique({ where: { id: serverId }, select: { instanceId: true } })
+    .catch(() => null);
+  if (!row) return 0;
+  return releaseLocksForInstance(row.instanceId);
