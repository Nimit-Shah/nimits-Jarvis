@@ -0,0 +1,155 @@
+import { db } from "~/server/clients/db";
+import { lockTargetFor } from "./lock-target";
+
+export { lockTargetFor };
+
+type ServerRef = {
+  id: string;
+  instanceId: string;
+  label: string;
+  browserMode?: string | null;
+  url: string;
+  cdpEndpoint?: string | null;
+};
+
+export type LockVerdict = { ok: true; target?: string } | { ok: false; message: string };
+
+/**
+ * In-flight cross-project guard: the ONLY refusal source. The API server is a
+ * single process (chat tool calls + cron execute routes), so an in-process
+ * registry is authoritative for "another project is executing right now".
+ * DB rows are leases for UI/ops; this map is the simultaneity barrier.
+ */
+const inFlight = new Map<string, Map<string, { label: string; count: number }>>();
+
+function activeOther(
+  target: string,
+  instanceId: string,
+): { instanceId: string; label: string } | null {
+  const byInstance = inFlight.get(target);
+  if (!byInstance) return null;
+  for (const [id, entry] of byInstance) {
+    if (id !== instanceId && entry.count > 0) return { instanceId: id, label: entry.label };
+  }
+  return null;
+}
+
+/** Marks a browser call as executing. false = another project is mid-call. */
+export function beginBrowserCall(target: string, instanceId: string, label: string): boolean {
+  if (activeOther(target, instanceId)) return false;
+  let byInstance = inFlight.get(target);
+  if (!byInstance) {
+    byInstance = new Map();
+    inFlight.set(target, byInstance);
+  }
+  const cur = byInstance.get(instanceId);
+  byInstance.set(instanceId, { label, count: (cur?.count ?? 0) + 1 });
+  return true;
+}
+
+export function endBrowserCall(target: string, instanceId: string): void {
+  const byInstance = inFlight.get(target);
+  if (!byInstance) return;
+  const cur = byInstance.get(instanceId);
+  if (!cur) return;
+  if (cur.count <= 1) byInstance.delete(instanceId);
+  else byInstance.set(instanceId, { label: cur.label, count: cur.count - 1 });
+  if (byInstance.size === 0) inFlight.delete(target);
+}
+
+async function inFlightRefusal(active: { instanceId: string; label: string }): Promise<string> {
+  const inst = await db.composioClawInstance
+    .findUnique({ where: { id: active.instanceId }, select: { name: true } })
+    .catch(() => null);
+  const project = inst?.name ?? "another project";
+  return `Browser is in use by ${project} / ${active.label} — a browser call is running right now. Wait for it to finish (or Release it from that project) — do not retry in a loop.`;
+}
+
+/**
+ * Project-scoped holder lease, steal-on-demand:
+ * - no lock row yet → claim (lazy; nothing exists before the first call)
+ * - same project (any row/chat) → share + heartbeat
+ * - different project → claim immediately, even if the lease is fresh; the
+ *   previous project claims back on its next call
+ * - refusal ONLY while another project is mid-call on this target
+ * - a row that holds a different target has switched modes → its old lease dies
+ * Claims are single-statement updates (last writer wins, no lost updates).
+ */
+export async function checkBrowserLock(row: ServerRef): Promise<LockVerdict> {
+  const target = lockTargetFor(row);
+  if (!target) return { ok: true };
+  const now = new Date();
+
