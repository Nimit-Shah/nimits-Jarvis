+
+/** Drop one target's lease only when THIS project holds it (mode switches, row deletes). */
+export async function releaseTargetIfHeldBy(target: string, instanceId: string): Promise<number> {
+  const r = await db.browserLock
+    .deleteMany({ where: { target, holderInstanceId: instanceId } })
+    .catch(() => ({ count: 0 }));
+  return r.count;
+}

