+      .catch(() => []);
+    if (stale.length > 0) {
+      await db.browserLock
+        .deleteMany({ where: { holderServerId: row.id, target: { in: stale.map((s) => s.target) } } })
+        .catch(() => undefined);
+    }
+  }
+
+  if (existing?.holderInstanceId === row.instanceId) {
+    const hb = await db.browserLock
+      .updateMany({ where: { target, holderInstanceId: row.instanceId }, data: { holderServerId: row.id } })
+      .catch(() => ({ count: 1 }));
