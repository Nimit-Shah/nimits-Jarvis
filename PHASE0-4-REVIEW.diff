+/**
+ * Browser lock targets — one lock per browser, never per row. Managed and
+ * extension rows sharing an MCP port contend for one child; CDP rows
+ * contend per endpoint. Two targets that share nothing never contend.
+ */
+export const LOCK_IDLE_MS = 10 * 60 * 1000;
+
+export function lockTargetFor(row: {
+  browserMode?: string | null;
+  url: string;
+  cdpEndpoint?: string | null;
+}): string | null {
+  if (row.browserMode === "cdp") {
+    if (!row.cdpEndpoint) return null;
+    return `cdp:${row.cdpEndpoint}`;
+  }
+  try {
+    const u = new URL(row.url);
+    const port = Number(u.port);
+    if (!Number.isInteger(port) || port <= 0) return null;
+    return `port:${port}`;
+  } catch {
+    return null;
+  }
+}
+
+export function describeLockAge(acquiredAt: Date, lastToolAt: Date, now = new Date()): string {
+  const heldMin = Math.max(0, Math.round((now.getTime() - acquiredAt.getTime()) / 60000));
+  const idleSec = Math.max(0, Math.round((now.getTime() - lastToolAt.getTime()) / 1000));
+  return `held ${heldMin} min, last action ${idleSec}s ago`;
+}

