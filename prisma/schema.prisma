generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum MessageRole {
  user
  assistant
}

enum MessageSource {
  web
  telegram
  cron
}

enum MessageType {
  regular
  compaction_summary
  memory_flush
  hidden
}

model User {
  id              String                 @id
  name            String
  email           String
  emailVerified   Boolean                @default(false)
  image           String?
  timezone        String                 @default("Asia/Kolkata")
  username        String?                @unique
  displayUsername String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        Session[]
  accounts        Account[]
  instances       ComposioClawInstance[]
  onboardingState OnboardingState?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ComposioClawInstance {
  id     String @id @default(cuid())
  userId String

  // Project name displayed in the UI switcher
  name String @default("Default")

  // Per-project Composio API key (AES-256-GCM encrypted at rest, null = use global env key)
  composioApiKey String?

  // Composio Project ID resolved from API
  composioProjectId String?

  // Anthropic config — the DEFAULT model for new chats within this instance
  anthropicModel String @default("qwen3:8b")

  // PII redaction — enabled by default for all non-local models.
  // When true, user data from Composio tool results is tokenised before
  // being sent to external LLMs and restored in the response.
  piiRedactionEnabled Boolean @default(true)

  // API Gateways
  vercelGatewayEnabled     Boolean @default(true)
  openRouterGatewayEnabled Boolean @default(true)

  // Telegram linking
  telegramChatId             String?   @unique
  telegramLinkToken          String?   @unique
  telegramLinkTokenExpiresAt DateTime?

  // Voice mode — STT/TTS are orthogonal (v1 local-only)
  // STT: Whisper model id (tiny/base/small/medium/large-v3). Small default for latency on 16GB M2.
  sttModel     String @default("small")
  sttProvider  String @default("local") // local | openrouter (future)
  // TTS: provider + voice id. Fish S2.1 Pro Free via OpenRouter (no separate key;
  // reuses OPENROUTER_API_KEY) — low latency vs local piper.
  ttsProvider String @default("fish-audio")
  ttsVoice    String @default("s2.1-pro-free")
  // Free-text voice style/steering prompt for Fish (e.g. "deep warm male, unhurried").
  // Pinned per request so every synthesis uses the SAME voice take.
  voiceStyle  String @default("")

  // File system access (Phase A read-only)
  fsReadEnabled  Boolean @default(true)   // may this project read local files at all
  fsWriteAllowed Boolean @default(false)  // ceiling for Phase B writes; Settings only
  fsRootPath     String?                  // optional root override; null means os.homedir()

  // Agent identity, stored as text
  soulPrompt      String?
  identityPrompt  String?
  userPrompt      String?

  // Token-efficiency allowlist (docs/TOKEN_EFFICIENCY.md §5.2): array of
  // tool names (COMPOSIO_-prefix stripped) this project may expose. Null/empty
  // = unrestricted (default); when set, non-listed Composio tools are dropped
  // from the toolset and COMPOSIO_SEARCH_TOOLS is removed entirely.
  composioToolAllowlist Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  chats      Chat[]
  messages   Message[]
  memories   Memory[]
  cronJobs   CronJob[]
  mcpServers McpServer[]
  fileChanges FileChange[]
  toolResults ToolResult[]
  toolUsages  ToolUsage[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("composio_claw_instance")
}

model McpServer {
  id           String   @id @default(cuid())
  instanceId   String
  instance     ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  name         String // slug: lowercase, [a-z0-9-]; becomes namespace segment
  label        String // human display name
  url          String // http://127.0.0.1:3845/mcp | https://mcp.example.com/mcp
  headersEnc   String? // AES-256-GCM ciphertext of Record<string,string>
  enabled      Boolean  @default(true)

  status       String   @default("unknown") // unknown | ok | failed | unreachable
  lastError    String?
  lastSyncedAt DateTime?
  needsSync    Boolean  @default(false)

  tools     McpTool[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, name])
  @@index([instanceId])
  @@map("mcp_server")
}

model McpTool {
  id             String   @id @default(cuid())
  mcpServerId    String
  server         McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  originalName   String // exact name to send back in callTool()
  namespacedName String // mcp__<server>__<tool>; what the model sees
  description    String?
  inputSchema    Json // JSON Schema as returned by listTools()

  enabled  Boolean @default(false) // OFF by default
  cronSafe Boolean @default(false)

  @@unique([mcpServerId, originalName])
  @@index([mcpServerId, enabled])
  @@map("mcp_tool")
}

model Chat {
  id                    String    @id @default(cuid())
  instanceId            String
  name                  String    @default("New Chat")
  model                 String    @default("qwen3:8b")
  compactionCount       Int       @default(0)
  compactionAttempts    Int       @default(0)
  lastCompactionSummary String?
  lastCompactionAt      DateTime?
  tokensAtCompaction    Int?
  memoryFlushCount      Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages Message[]
  cronJobs CronJob[]
  fileChanges FileChange[]
  toolResults ToolResult[]
  skillConsents SkillConsent[]

  @@index([instanceId, updatedAt])
  @@map("composio_claw_chat")
}

model Message {
  id          String        @id @default(cuid())
  instanceId  String
  chatId      String?
  role        MessageRole
  content     Json
  source      MessageSource @default(web)
  messageType MessageType   @default(regular)

  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?

  // Token-efficiency instrumentation (docs/TOKEN_EFFICIENCY.md §0.1) —
  // per-section payload estimates { system, tools, history, current, toolResults }
  sectionTokens Json?
  ttftMs        Int? // first byte of the SSE response stream (null for telegram/cron)
  genMs         Int? // stream start → onFinish
  finishReason  String?
  // Agent-run lifecycle: completed | cancelled | aborted | failed | timed_out.
  // Set on the assistant row by onFinish/error/abort paths — never leave an
  // interrupted run as a silent empty message.
  runStatus String?

  createdAt DateTime             @default(now())
  instance  ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  chat      Chat?                @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
  @@index([chatId, createdAt])
  @@map("composio_claw_message")
}

model ToolResult {
  id         String   @id @default(cuid())
  instanceId String
  chatId     String
  callId     String   @unique
  toolName   String
  payload    Json
  createdAt  DateTime @default(now())

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  chat     Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("composio_claw_tool_result")
}

model ToolUsage {
  id         String   @id @default(cuid())
  instanceId String
  toolName   String
  calls      Int      @default(0)
  successes  Int      @default(0)
  lastUsedAt DateTime

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, toolName])
  @@map("composio_claw_tool_usage")
}

model Memory {
  id         String                      @id @default(cuid())
  instanceId String
  content    String
  embedding  Unsupported("VECTOR(384)")
  createdAt  DateTime                    @default(now())

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
  @@map("composio_claw_memory")
}

model CronJob {
  id         String    @id @default(cuid())
  instanceId String
  chatId     String?
  expression String
  prompt     String
  timezone   String    @default("Asia/Kolkata")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?

  lockedAt  DateTime?
  lockedBy  String?
  lastError String?

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  chat     Chat?                @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([instanceId, nextRunAt])
  @@map("composio_claw_cron_job")
}

// Phase B: per-change approval journal for filesystem writes.
// One row per proposed change; status lifecycle: pending → applied | rejected |
// stale | failed | undone. sha256Before binds the approval (TOCTOU guard).
model FileChange {
  id           String    @id @default(cuid())
  instanceId   String
  chatId       String
  messageId    String? // backfilled opportunistically at execute; nullable by design
  toolCallId   String    @unique // ties the row to the streamed tool call

  op           String // edit | write | delete | mkdir | move
  path         String // realpathed absolute target
  toPath       String? // move only

  sha256Before String? // null when creating a new file
  sha256After  String? // computed at pre-flight, verified after write
  bytesBefore  Int?
  bytesAfter   Int?
  diff         String?   @db.Text // unified diff, truncated for display

  status       String    @default("pending")
  rejectReason String?
  error        String?
  backupPath   String? // journal copy, for undo

  approvedAt DateTime?
  appliedAt  DateTime?
  createdAt  DateTime  @default(now())

  instance ComposioClawInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  chat     Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([instanceId, status])
  @@map("composio_claw_file_change")
}

model OnboardingState {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStep    String
  name           String   @default("")
  writingStyle   String?
  personality    String?
  emoji          String?
  lore           String   @default("") @db.Text
  anthropicModel String   @default("qwen3:8b")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_state")
}

// Part IV — Jarvis Skills. Instructions live on the filesystem (source of
// record for content); Postgres is the index of record for discovery.
model Skill {
  id         String  @id @default(cuid())
  userId     String
  instanceId String? // null = available to every project for this user

  slug        String // stable, from frontmatter name
  displayName String
  description String @db.Text // routing signal; goes in the Tier-1 index
  origin      String // authored | imported | bundled
  sourceRepo  String?
  sourceRef   String? // commit or tag
  dirPath     String // <skillsRoot>/<slug>/ — SKILL.md plus assets
  contentHash String // sha256 of SKILL.md, for change detection
  version     String?

  trustTier     String   @default("untrusted") // untrusted | verified | trusted
  toolsRequired String[] // exact tool names; acts as a CAP (Phase 2)
  stateScope    String   @default("none") // none | session | persistent

  scanFindings Json? // Phase 2 static-scan findings, shown in Settings

  // Phase 8 auto-discovery audit trail — manual imports leave these null.
  discoverySource String? // "auto" | "manual"
  discoveryQuery  String? // the find_skill query that led here ("auto" only)

  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  states SkillState[]

  @@unique([userId, slug])
  @@index([userId, enabled])
  @@map("composio_claw_skill")
}

model SkillState {
  id      String @id @default(cuid())
  skillId String  // Scope key with empty-string sentinels (never null) so the composite
  // unique stays enforceable — Postgres treats NULL as distinct, which would
  // let duplicate persistent rows (null chatId) slip through. Session scope
  // sets chatId, persistent scope sets instanceId, the unused half stays "".
  chatId     String @default("")
  instanceId String @default("")
  data       Json

  updatedAt DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, chatId, instanceId])
  @@map("composio_claw_skill_state")
}

// Phase 8 conversational consent: an auto-installed (untrusted) skill becomes
// usable only after a recorded affirmative reply in the same chat. One row per
// chat+slug; audit trail is kept, never deleted. Consent applies to the single
// next user message after install (stale pendings never auto-fire).
model SkillConsent {
  id     String @id @default(cuid())
  chatId String
  slug   String
  status String @default("pending") // pending | confirmed | declined

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, slug])
  @@index([chatId, status])
  @@map("composio_claw_skill_consent")
}
