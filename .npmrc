public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
# Required for @huggingface/transformers: its ESM bundle imports onnxruntime-common
# as a bare specifier; pnpm must hoist it to the flat node_modules root so ESM
# resolution can find it alongside onnxruntime-node.
public-hoist-pattern[]=onnxruntime-common
public-hoist-pattern[]=onnxruntime-node
public-hoist-pattern[]=onnxruntime-web