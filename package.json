    "js-yaml": "^5.4.1",
    "lucide-react": "^0.563.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.2",
    "react": "19.2",
    "react-dom": "19.2",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "resumable-stream": "^2.2.12",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.0.15",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^7.10.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
